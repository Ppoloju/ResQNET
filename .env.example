# ============================================================
# ResQNET — Offline AI Emergency Network (iQOO Hackathon)
# Copy to backend/.env and adjust. NEVER commit real secrets.
# ============================================================

# ---------- Presets ----------
# LOCAL:        solo dev on one machine (default)
# DEVELOPMENT:  shared dev, verbose logs
# DEMO:         hackathon demo mode (simulation transports enabled)
# PRODUCTION:   hardened (real secrets, strict rate limits, HTTPS assumed)

NODE_ENV=development
PORT=4000

# SQLite file (docker volume mounted at /app/data)
DATABASE_PATH=./data/iqoo.sqlite

# --- Secrets: generate with `openssl rand -hex 32` (or node: crypto.randomBytes(32).toString('hex')) ---
JWT_SECRET=change-me-local-only
MSG_SIGNING_PEPPER=change-me-local-only

# Frontend origin allowed by backend CORS (comma-separated). Docker SPA is :8080.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:8080

# Rate limiting (requests per minute)
RATE_LIMIT_AUTH=10
RATE_LIMIT_API=120

# External notification adapters. Leave blank to queue deliveries as PENDING.
# Each endpoint receives a JSON POST with channel, recipient, and emergency data.
SMS_WEBHOOK_URL=
PUSH_WEBHOOK_URL=
EMERGENCY_SERVICE_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=

# Sync / retention
SYNC_BATCH_SIZE=50
EVENT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365

# Mesh tuning
MESH_TTL_SECONDS=3600
MESH_MAX_HOPS=8
MESH_BEACON_INTERVAL_MS=10000

# ---------- Email (account security: verification, 2FA, password reset) ----------
# Any SMTP provider works (Gmail app password, Mailtrap, Resend...).
# With SMTP_HOST empty the backend prints codes to its console (local dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ResQNET <no-reply@resqnet.app>
EMAIL_CODE_RESEND_SECONDS=45

# Team demo accounts are seeded on backend boot:
# ppoloju@ / vinturi@ / speesa@ student.gitam.edu  password Gitam@2028
# Override the default +919000000001/2/3 numbers here.
TEAM_PHONE_PPOLOJU=
TEAM_PHONE_VINTURI=
TEAM_PHONE_SPEESA=

# Live streams: SQLite change feeds default to polling; pass a filename to enable
# (see docs/architecture.md). Leave empty for default polling behavior.
SQLITE_CHANGE_FEED_STREAM=

# DEMO preset (used only when NODE_ENV=demo or DEMO_MODE=true)
DEMO_MODE=false
